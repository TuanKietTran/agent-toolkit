{
  "name": "pi",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone CLI agent with an independent extension system",
  "type": "module",
  "bin": { "pi": "dist/src/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
