{
  "name": "pi-agent-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "TuanKietTran's bundled extensions for the Pi coding agent",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test core/dev/*.test.ts",
    "install:tui": "node ./tui/install-layout.mjs",
    "build:min": "node scripts/minify.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.52.0"
  },
  "pi": {
    "extensions": [
      "./gc-assets/index.ts",
      "./thinking-control.ts",
      "./usage-roundrobin.ts",
      "./remote-control.ts"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
