{
  "description": "Wire fixtures for relations (contract: packages/h1/src/wire.rs in the manager worktree). Edge/Request/Response shapes are verbatim wire JSON. An edge from->to is stored in BOTH endpoint hosts: relation_add is sent to the from host with mirror false and mirrored to the to host with mirror true. cascade is only meaningful for parent.",
  "edges": [
    { "from": "producer", "kind": "parent", "to": "consumer", "cascade": true },
    { "from": "consumer", "kind": "depends_on", "to": "producer", "cascade": false },
    { "from": "producer", "kind": "supervises", "to": "consumer", "cascade": false },
    { "from": "producer", "kind": "pairs_with", "to": "consumer", "cascade": false }
  ],
  "add_request": {
    "op": "relation_add",
    "edge": { "from": "producer", "kind": "parent", "to": "consumer", "cascade": true },
    "mirror": false
  },
  "add_request_mirrored": {
    "op": "relation_add",
    "edge": { "from": "producer", "kind": "parent", "to": "consumer", "cascade": true },
    "mirror": true
  },
  "remove_request": {
    "op": "relation_remove",
    "edge": { "from": "consumer", "kind": "depends_on", "to": "producer", "cascade": false },
    "mirror": false
  },
  "list_request": { "op": "relation_list" },
  "list_response_consumer": {
    "ok": true,
    "edges": [
      { "from": "producer", "kind": "parent", "to": "consumer", "cascade": true },
      { "from": "consumer", "kind": "depends_on", "to": "producer", "cascade": false }
    ]
  },
  "release_request": { "op": "relation_release", "app": "producer" }
}
