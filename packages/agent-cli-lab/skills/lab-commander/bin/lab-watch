#!/bin/sh
# Wait for the first useful commander event in a named Pi/agent-cli-lab session.
set -eu
[ "$#" -ge 1 ] || { echo "Usage: lab-watch <name> [timeout-seconds]" >&2; exit 2; }
name=$1; timeout=${2:-1800}; start=$(date +%s); previous='';
while :; do
  now=$(date +%s)
  if [ "$((now-start))" -ge "$timeout" ]; then echo "WATCH-TIMEOUT $name"; exit 124; fi
  screen=$(agent-cli-lab screen -n "$name" 2>&1 || true)
  [ -n "$screen" ] || { echo "WATCH-GONE $name"; exit 0; }
  if printf '%s\n' "$screen" | grep -E 'LAB-BLOCKED|usage limit|rate limit|Usage limit' >/dev/null; then
    printf '%s\n' "$screen"; exit 0
  fi
  if [ -n "$previous" ] && [ "$screen" != "$previous" ]; then
    if printf '%s\n' "$screen" | grep -E 'LAB-CHECKPOINT|LAB-DONE' >/dev/null; then printf '%s\n' "$screen"; exit 0; fi
  fi
  state=$(agent-cli-lab status -n "$name" 2>&1 || true)
  if printf '%s\n' "$state" | grep -iE 'asking|stalled|idle' >/dev/null; then printf '%s\n' "$screen"; exit 0; fi
  previous=$screen
  sleep 2
done
