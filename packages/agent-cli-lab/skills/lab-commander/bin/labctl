#!/usr/bin/env python3
"""labctl: commander-side control of interactive agent CLIs (pi, claude, codex)
hosted in PTYs by agent-cli-lab. Stdlib only.

State lives in $LABCTL_HOME (default ~/.lab-commander):
  labs/<name>.json   one record per lab (socket, pid, agent, model, cwd)
  ledger.jsonl       append-only checkpoints and decisions, survives usage resets
"""
import argparse, json, os, re, signal, subprocess, sys, time
from pathlib import Path

HOME = Path(os.environ.get("LABCTL_HOME", Path.home() / ".lab-commander"))
LABS = HOME / "labs"
LEDGER = HOME / "ledger.jsonl"
LAB = os.environ.get("AGENT_CLI_LAB", "agent-cli-lab")

# One adapter per agent CLI. `model_flag` is passed at launch; `model_slash`
# is typed into the TUI after launch for CLIs that switch models in-session.
ADAPTERS = {
    "sh":     {"cmd": ["sh"],     "model_flag": None,      "model_slash": None,            "reload": None,      "stop": ["C-c"]},  # smoke tests
    "pi":     {"cmd": ["pi"],     "model_flag": None,      "model_slash": "/model {model}", "reload": "/reload", "stop": ["C-c", "C-c"]},
    "claude": {"cmd": ["claude"], "model_flag": "--model", "model_slash": "/model {model}", "reload": None,      "stop": ["C-c", "C-c"]},
    "codex":  {"cmd": ["codex"],  "model_flag": "--model", "model_slash": None,             "reload": None,      "stop": ["C-c", "C-c"]},
}
DONE = re.compile(r"^\s*LAB-(DONE|BLOCKED|CHECKPOINT)\b(.*)$", re.M)
PICKER = re.compile(r"(Enter to select|No matching models)")
LIMIT = re.compile(r"(usage limit|rate limit|resets? (at|in)|quota)", re.I)


def die(msg, code=1):
    print(f"labctl: {msg}", file=sys.stderr); sys.exit(code)

def socket_dir():
    r = subprocess.run([LAB, "socket", "-p"], capture_output=True, text=True)
    return Path(r.stdout.strip()).parent if r.returncode == 0 and r.stdout.strip() else HOME

def lab_path(name): return LABS / f"{name}.json"

def load(name):
    p = lab_path(name)
    if not p.exists(): die(f"no lab named {name!r} (see: labctl ls)")
    return json.loads(p.read_text())

def alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False

def socket_pids(sock):
    r = subprocess.run(["lsof", "-n", "-U"], capture_output=True, text=True)
    pids = []
    for line in r.stdout.splitlines():
        fields = line.split()
        if sock in line and len(fields) > 1 and fields[1].isdigit() and alive(int(fields[1])):
            pids.append(int(fields[1]))
    return pids

def attach_pids(sock):
    r = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True)
    return [int(line.strip().split(None, 1)[0]) for line in r.stdout.splitlines()
            if sock in line and re.search(r"\bagent-cli-lab\s+attach\b", line)
            and line.strip().split(None, 1)[0].isdigit()]

def close_attaches(sock):
    for pid in attach_pids(sock):
        try: os.kill(pid, signal.SIGTERM)
        except OSError: pass

def cli(rec, *args, **kw):
    return subprocess.run([LAB, *args[:1], "-s", rec["socket"], *args[1:]],
                          capture_output=True, text=True, **kw)

def screen(rec):
    r = cli(rec, "screen")
    return r.stdout if r.returncode == 0 else ""

def log(event, **kw):
    HOME.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event, **kw}) + "\n")

# ---- commands -------------------------------------------------------------

def cmd_spawn(a):
    ad = ADAPTERS[a.agent]
    LABS.mkdir(parents=True, exist_ok=True)
    cwd = Path(a.cwd).expanduser()
    if not cwd.is_dir(): die(f"cwd does not exist or is not a directory: {cwd}")
    cwd = str(cwd.resolve())
    if lab_path(a.name).exists() and alive(load(a.name)["pid"]): die(f"{a.name} already running")
    sock = str(socket_dir() / f"{a.name}.sock")  # same dir `agent-cli-lab ls` scans, so `-s {name}` works too
    if os.path.exists(sock):
        pids = socket_pids(sock)
        if pids: die(f"socket already in use: {sock} (pid {pids[0]})")
        os.unlink(sock)
    cmd = list(ad["cmd"])
    if a.model and ad["model_flag"]: cmd += [ad["model_flag"], a.model]
    cmd += a.extra
    rec_file = str(HOME / f"{a.name}.jsonl")
    err_file = HOME / f"{a.name}.stderr.log"
    with err_file.open("a") as err:
        p = subprocess.Popen([LAB, "host", "-s", sock, "-r", rec_file, "-C", str(a.cols), "-R", str(a.rows), "--", *cmd],
                             cwd=cwd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=err)
    for _ in range(50):
        if os.path.exists(sock): break
        if p.poll() is not None: break
        time.sleep(0.1)
    if p.poll() is not None or not os.path.exists(sock):
        tail = "".join(err_file.read_text(errors="replace").splitlines(True)[-20:])
        die(f"host failed to start (stderr: {err_file})\n{tail.rstrip()}")
    rec = {"name": a.name, "agent": a.agent, "model": a.model, "cwd": cwd, "socket": sock, "pid": p.pid, "record": rec_file, "stderr": str(err_file)}
    lab_path(a.name).write_text(json.dumps(rec, indent=1))
    time.sleep(a.boot)
    if not alive(p.pid):
        tail = "".join(err_file.read_text(errors="replace").splitlines(True)[-20:])
        lab_path(a.name).unlink(missing_ok=True)
        try: os.unlink(sock)
        except OSError: pass
        die(f"host died after startup (stderr: {err_file})\n{tail.rstrip()}")
    if a.model and not ad["model_flag"] and ad["model_slash"]:
        cli(rec, "ask", ad["model_slash"].format(model=a.model), "-t", "30")
        cli(rec, "send", "-e", "")  # confirm a picker if one opened
        for _ in range(2):  # picker still open (no match / already on model): dismiss it so briefs are not swallowed
            if not PICKER.search(screen(rec)[-1500:]): break
            cli(rec, "send", "\x1b"); time.sleep(0.4)
    if not a.no_open and not os.environ.get("LABCTL_NO_OPEN") and not attach_pids(sock):
        with err_file.open("a") as err:
            subprocess.Popen([LAB, "foreground", "-s", sock, "--terminal", os.environ.get("AGENT_CLI_LAB_TERMINAL", "Ghostty")],
                             stdout=subprocess.DEVNULL, stderr=err)
    log("spawn", lab=a.name, agent=a.agent, model=a.model, cwd=cwd)
    print(f"{a.name} up (pid {p.pid}, socket {sock})")

def names_of(a):
    """`a,b,c` or --all -> list of lab names."""
    if getattr(a, "all", False): return sorted(p.stem for p in LABS.glob("*.json"))
    return [n for n in a.name.split(",") if n]

def cmd_ask(a):
    if a.all and a.name: a.text.insert(0, a.name)  # with --all the first word is text, not a lab name
    text = Path(a.file).read_text() if a.file else " ".join(a.text)
    for n in names_of(a):
        rec = load(n)
        if a.no_wait:  # type + Enter and return at once; a busy agent never settles, so ask would block
            cli(rec, "send", "-e", text); print(f"{n}: sent"); continue
        r = cli(rec, "ask", text, "-i", str(a.idle), "-t", str(a.timeout))
        print(r.stdout)
        tail = " ".join(screen(rec).splitlines()[-4:])
        if text.strip() and re.sub(r"\s+", " ", text.strip()) in re.sub(r"\s+", " ", tail):
            cli(rec, "send", "-e", "")

def cmd_screen(a):
    s = screen(load(a.name))
    if a.tail: s = "\n".join([l for l in s.splitlines() if l.strip()][-a.tail:])
    print(s)

KEYS = {"esc": "\x1b", "tab": "\t", "up": "\x1b[A", "down": "\x1b[B", "right": "\x1b[C", "left": "\x1b[D", "space": " "}

def cmd_send(a):
    rec = load(a.name); flags = []
    if a.enter: flags.append("-e")
    if a.ctrl_c: flags.append("-c")
    text = KEYS[a.key] if a.key else a.text
    r = cli(rec, "send", *flags, *([text] if text else []))
    print(r.stdout, end="")

def classify(rec):
    """Return (state, detail). States: dead, limit, done, blocked, working."""
    if not alive(rec["pid"]): return "dead", ""
    s = screen(rec)
    marks = DONE.findall(s)
    if marks:
        kind, rest = marks[-1]
        return {"DONE": "done", "BLOCKED": "blocked", "CHECKPOINT": "working"}[kind], rest.strip()
    if LIMIT.search(s[-1500:]): return "limit", LIMIT.search(s[-1500:]).group(0)
    if PICKER.search(s[-1500:]): return "blocked", "picker open: labctl send <lab> -k esc"
    return "working", ""

def cmd_status(a):
    names = [a.name] if a.name else sorted(p.stem for p in LABS.glob("*.json"))
    for n in names:
        rec = load(n); state, detail = classify(rec)
        print(f"{n:16} {rec['agent']:7} {state:8} {detail}")

def cmd_wait(a):
    """Block until the lab reports DONE/BLOCKED, hits a usage limit, or dies."""
    recs = {n: load(n) for n in names_of(a)}; end = time.time() + a.timeout; seen = {}
    while time.time() < end and len(seen) < len(recs):  # `a,b` / --all: return when every lab has settled
        for n, rec in recs.items():
            if n in seen: continue
            state, detail = classify(rec)
            if state != "working": seen[n] = f"{state} {detail}".strip()
        time.sleep(a.poll if len(seen) < len(recs) else 0)
    for n in recs: print(f"{n}: {seen.get(n, 'timeout')}")
    if len(seen) < len(recs): sys.exit(3)
    sys.exit(0 if all(v.startswith("done") for v in seen.values()) else 2)

def cmd_checkpoint(a):
    log("checkpoint", lab=a.name, note=" ".join(a.note)); print("recorded")

def cmd_resume(a):
    """Re-brief a lab from the ledger after a reset or crash: last checkpoints, then continue."""
    rec = load(a.name)
    rows = [json.loads(l) for l in LEDGER.read_text().splitlines()] if LEDGER.exists() else []
    mine = [r for r in rows if r.get("lab") == a.name and r["event"] in ("checkpoint", "decision")][-a.last:]
    if not mine: die("no checkpoints recorded for this lab")
    brief = "Resume. Ledger so far (oldest first):\n" + "\n".join(f"- {r['event']}: {r.get('note') or r.get('text')}" for r in mine)
    brief += "\nContinue from the last checkpoint. Do not redo finished steps. End with LAB-DONE or LAB-BLOCKED <reason>."
    cli(rec, "ask", brief, "-t", "20"); log("resume", lab=a.name); print("resumed")

def cmd_decide(a):
    log("decision", lab=a.name, text=" ".join(a.text)); print("recorded")

def cmd_close(a):
    names = [p.stem for p in LABS.glob("*.json")] if a.all else [a.name]
    for n in names:
        rec = load(n)
        for _ in range(2): cli(rec, "send", "-c"); time.sleep(0.4)
        close_attaches(rec["socket"])
        try: os.killpg(os.getpgid(rec["pid"]), signal.SIGTERM)
        except (OSError, ProcessLookupError): pass
        try: os.unlink(rec["socket"])
        except OSError: pass
        lab_path(n).unlink(missing_ok=True); log("close", lab=n); print(f"closed {n}")

def cmd_ledger(a):
    if LEDGER.exists(): print("".join(LEDGER.read_text().splitlines(True)[-a.n:]), end="")

def main():
    p = argparse.ArgumentParser(prog="labctl"); sp = p.add_subparsers(dest="c", required=True)
    s = sp.add_parser("spawn"); s.add_argument("name"); s.add_argument("--agent", choices=ADAPTERS, required=True)
    s.add_argument("--model"); s.add_argument("--cwd", default=os.getcwd()); s.add_argument("--cols", type=int, default=140)
    s.add_argument("--rows", type=int, default=45); s.add_argument("--boot", type=float, default=4.0)
    s.add_argument("--no-open", action="store_true"); s.add_argument("extra", nargs="*"); s.set_defaults(f=cmd_spawn)
    s = sp.add_parser("ask"); s.add_argument("name", nargs="?", default=""); s.add_argument("text", nargs="*"); s.add_argument("-f", "--file")
    s.add_argument("-i", "--idle", type=int, default=3000); s.add_argument("-t", "--timeout", type=int, default=180)
    s.add_argument("--no-wait", action="store_true"); s.add_argument("--all", action="store_true"); s.set_defaults(f=cmd_ask)
    s = sp.add_parser("screen"); s.add_argument("name"); s.add_argument("-n", "--tail", type=int, default=0); s.set_defaults(f=cmd_screen)
    s = sp.add_parser("send"); s.add_argument("name"); s.add_argument("text", nargs="?"); s.add_argument("-e", "--enter", action="store_true")
    s.add_argument("-c", "--ctrl-c", action="store_true"); s.add_argument("-k", "--key", choices=KEYS); s.set_defaults(f=cmd_send)
    s = sp.add_parser("status"); s.add_argument("name", nargs="?"); s.set_defaults(f=cmd_status)
    sp.add_parser("ls").set_defaults(f=cmd_status, name=None)
    s = sp.add_parser("wait"); s.add_argument("name", nargs="?", default=""); s.add_argument("--all", action="store_true")
    s.add_argument("--timeout", type=int, default=1800); s.add_argument("--poll", type=int, default=20); s.set_defaults(f=cmd_wait)
    s = sp.add_parser("checkpoint"); s.add_argument("name"); s.add_argument("note", nargs="+"); s.set_defaults(f=cmd_checkpoint)
    s = sp.add_parser("decide"); s.add_argument("name"); s.add_argument("text", nargs="+"); s.set_defaults(f=cmd_decide)
    s = sp.add_parser("resume"); s.add_argument("name"); s.add_argument("--last", type=int, default=8); s.set_defaults(f=cmd_resume)
    s = sp.add_parser("close"); s.add_argument("name", nargs="?"); s.add_argument("--all", action="store_true"); s.set_defaults(f=cmd_close)
    s = sp.add_parser("ledger"); s.add_argument("-n", type=int, default=30); s.set_defaults(f=cmd_ledger)
    a = p.parse_args(); a.f(a)

if __name__ == "__main__": main()
