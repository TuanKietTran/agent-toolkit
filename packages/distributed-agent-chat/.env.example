# Template only. Copy via `npm run setup` to generate private secrets instead of using placeholders.
# Do not commit .env. Configure one token per agent target in AGENT_TOKENS JSON.
CHAT_TOKEN=replace-with-at-least-24-random-characters
AGENT_TOKENS={"pi":"replace-with-distinct-random-pi-token","claude":"replace-with-distinct-random-claude-token","codex":"replace-with-distinct-random-codex-token","opencode":"replace-with-distinct-random-opencode-token","ollama":"replace-with-distinct-random-ollama-token"}
CHAT_HOST=127.0.0.1
CHAT_PORT=18877
CHAT_DATA_DIR=.data/miniflare
# Deployment helper requires explicit CONFIRM_FLEET_DEPLOY=YES and CELLD_BUCKET.
