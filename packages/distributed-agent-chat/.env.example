# Copy to .env for Compose, replace all placeholders with distinct random values.
# These are placeholders, not working credentials. Do not commit .env.
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-long-local-minio-password
CHAT_TOKEN=replace-with-random-user-token
PI_TOKEN=replace-with-different-random-pi-token
CLAUDE_TOKEN=replace-with-different-random-claude-token
# Loopback Worker ports; 8787 is occupied by the Pi bridge.
CHAT_PORT_A=18877
CHAT_PORT_B=18878
