yah 1

// team.yah - commander -> builder, modelled on the canonical example
// in docs/graphspec.md but with a realistic model catalog.
// The resolved model reaches the hosted program only through
// interpolation. ${harnesses.<label>.model} expands at open time to
// the resolved model in provider_type/id form (e.g.
// anthropic/claude-sonnet-5-5); ${harnesses.<label>.model_id} expands
// to the bare id (e.g. claude-sonnet-5-5). The commands below use
// model_id: pi is given --provider claude-cli, whose --model expects
// the bare id, as in examples/research-team.yah.

variable "work_dir" {
  type = "string"
  default = "./work"
}

defaults {
  model_policy = "system-one"
  sandbox = "local"
}

provider "anthropic" {
  type = "anthropic"
  api_key = env.ANTHROPIC_API_KEY
}

model "sonnet" {
  provider = "anthropic"
  id = "claude-sonnet-5-5"
  capabilities = ["chat", "tools", "vision"]
}

model "haiku" {
  provider = "anthropic"
  id = "claude-haiku-5-5"
  capabilities = ["chat", "tools"]
}

model "opus" {
  provider = "anthropic"
  id = "claude-opus-5"
  capabilities = ["chat", "tools", "vision"]
}

system_one {
  fallback = "sonnet"
  student = "data/student_model.json"
}

api "fs" {
  type = "mcp"
  command = ["npx", "-y", "@modelcontextprotocol/server-filesystem", var.work_dir]
}

harness "commander" {
  kind = "h1"
  role = "commander"
  model = "system-one"
  tools = ["fs"]
  open {
    command = ["pi", "--provider", "claude-cli", "--model", "${harnesses.commander.model_id}", "--no-session"]
    cols = 140
    rows = 40
  }
}

harness "builder" {
  kind = "h1"
  role = "builder"
  parent = "commander"
  model = "system-one"
  tools = ["fs"]
  open {
    command = ["pi", "--provider", "claude-cli", "--model", "${harnesses.builder.model_id}", "--no-session"]
    cwd = var.work_dir
  }
}

team "default" {
  root = "commander"
  members = ["builder"]
  graph = true
}
